{
  "mcpServers": {
    "filesystem-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "env": {}
    },
    "git-mcp": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "."
      ],
      "env": {}
    },
    "memory-graph-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {}
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "env": {}
    },
    "fetch-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-fetch"
      ],
      "env": {}
    },
    "codebase-memory": {
      "command": "npx",
      "args": [
        "-y",
        "codebase-memory-mcp"
      ],
      "env": {}
    },
    "strands-tools": {
      "command": "python",
      "args": [
        "-m",
        "strands_tools"
      ],
      "env": {}
    },
    "scientific-skills": {
      "command": "node",
      "args": [
        "scientific-skills/scripts/run.js"
      ],
      "env": {}
    },
    "openjarvis": {
      "command": "node",
      "args": [
        "open-jarvis/scripts/run.js"
      ],
      "env": {}
    },
    "awesome-llm-apps": {
      "command": "python",
      "args": [
        "-m",
        "awesome_llm_apps"
      ],
      "env": {}
    },
    "agency-agents": {
      "command": "node",
      "args": [
        "agency-agents/scripts/run.js"
      ],
      "env": {}
    },
    "jev-ultrafast": {
      "command": "python",
      "args": [
        "-m",
        "jev_ultrafast"
      ],
      "env": {}
    },
    "open-code-review": {
      "command": "node",
      "args": [
        "open-code-review/bin/ocr.js"
      ],
      "env": {}
    },
    "ruflo-swarm": {
      "command": "node",
      "args": [
        "ruflo/bin/ruflo.js"
